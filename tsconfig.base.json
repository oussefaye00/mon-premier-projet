{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@amai/core": ["packages/core/src/index.ts"],
      "@amai/renderer": ["packages/renderer/src/index.ts"],
      "@amai/ai": ["packages/ai/src/index.ts"],
      "@amai/bridge": ["packages/bridge/src/index.ts"]
    }
  }
}
