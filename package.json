{
  "name": "after-motion-ai",
  "private": true,
  "version": "0.1.0",
  "description": "AFTER MOTION AI — éditeur vidéo & motion design avec assistant IA et serveur MCP",
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "npm run dev -w @amai/editor",
    "build": "npm run build -w @amai/editor && npm run build -w @amai/mcp-server",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run-e2e.mjs",
    "mcp": "node packages/mcp-server/dist/index.js"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "esbuild": "0.24.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
